{% extends "interviewer/dashboard/base.html.twig" %}

{% trans_default_domain "interviewer" %}
{% set title_translation_key = "survey-areas.page-title" %}
{% set title_translation_parameters = {
    'name': app.user.interviewer.name
} %}

{%- block beforePageHeading -%}
    {{- parent() -}}

    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import notificationBanner -%}

    {%- if (areasWithOverdueHouseholds ?? []) | length > 0 -%}
        {{- notificationBanner({
            title: 'survey-areas.overdue-households.title',
            content: 'survey-areas.overdue-households.content',
            options: {style: 'warning', nl2br: true},
            translation_domain: 'interviewer',
            translation_parameters: {numberOfHouseholds: overdueHouseholds | length, numberOfAreas: areasWithOverdueHouseholds | length}
        }) -}}
    {%- endif -%}
{%- endblock -%}

{% block content %}
    {%- import "interviewer/dashboard/macros.html.twig" as d -%}

    {{- d.areaPeriodList(
        areaPeriods,
        "survey-areas.current.title" | trans,
        "survey-areas.current.no-areas" | trans,
        areasWithOverdueHouseholds
    ) -}}

    <p class="govuk-body">
        <a class="govuk-link" href="{{ path('interviewer_dashboard_archived_areas') }}">{{ 'survey-areas.view-archived' | trans }}</a>
    </p>
{% endblock %}