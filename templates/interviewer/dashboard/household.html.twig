{% extends "interviewer/dashboard/base.html.twig" %}

{% set areaPeriod = household.areaPeriod %}

{% trans_default_domain "interviewer" %}

{% set title_translation_key = "household.page-title" %}
{% set title_translation_parameters = {
    serial: household.serialNumber
} %}

{%- block beforePageHeading -%}
    {{- parent() -}}

    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import notificationBanner -%}

    {%- if household.isOverdue() -%}
        {{- notificationBanner({
            title: 'household.overdue.title',
            content: 'household.overdue.content',
            options: {style: 'warning', nl2br: true},
            translation_domain: 'interviewer',
        }) -}}
    {%- endif -%}
{%- endblock -%}

{% block content %}
    {%- from "@GhostGovUkFrontend/components/macros.html.twig" import details, summaryListActionsList, summaryListRow, tag -%}
    {% from "interviewer/dashboard/macros.html.twig" import diaryKeeperState, householdState %}

    {% set htmlContent %}
        <p class="govuk-body">{{ 'household.help-details.content' | trans }}</p>
        {% from 'macros/vimeo-container.html.twig' import videoContainer %}
        {{ videoContainer(vimeo_ids.interviewer_editing, 'household.help-details.text' | trans) }}
    {% endset %}
    {{ details({
        summaryText: 'household.help-details.text' | trans,
        html: htmlContent,
    }) }}

    <dl class="govuk-summary-list">
        {{ summaryListRow({
            key: "household.diary-week-start-date" | trans,
            value: household.diaryWeekStartDate|date(date_time_format.date('default')),
        }, false) }}
        {%- set stateContent -%}
            {{- householdState(household.state) -}}{%- if household.isOverdue() %} {{ householdState('overdue') }}{% endif -%}
        {%- endset -%}
        {{ summaryListRow({
            key: "household.table.state" | trans,
            value: {html: stateContent},
        }, false) }}
        {{ summaryListRow({
            key: "household.journey-sharing" | trans,
            value: ("boolean." ~ (household.journeySharingEnabled ? 'true' : 'false')) | trans([], 'messages'),
        }, false) }}
        {% if household.isSubmitted %}
            {{ summaryListRow({
                key: "household.submitted-for-processing" | trans,
                value: (
                    household.submittedAt | date(
                        date_time_format.date('default') ~ " " ~ date_time_format.time('user-pref')
                    ) ~ "\n" ~ household.submittedBy
                )
            }, false) }}
        {% endif %}
    </dl>

    <p class="govuk-body">
        <a class="govuk-button" href="{{ path('interviewer_household_compare_day', {household: household.id, day: 1}) }}">View / amend diaries</a>
    </p>

    <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--m">{{ "household.diary-keepers" | trans }}</caption>
        <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">{{ "household.table.number" | trans }}</th>
            <th scope="col" class="govuk-table__header nowrap">{{ "household.table.name" | trans }}</th>
            <th scope="col" class="govuk-table__header nowrap">{{ "household.table.has-journeys" | trans }}</th>
            <th scope="col" class="govuk-table__header nowrap">{{ "household.table.media-type" | trans }}</th>
            <th scope="col" class="govuk-table__header nowrap">{{ "household.table.has-login" | trans }}</th>
            <th scope="col" class="govuk-table__header nowrap">{{ "household.table.type" | trans }}</th>
            <th scope="col" class="govuk-table__header nowrap">{{ "household.table.state" | trans }}</th>
            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">{{ 'table.action-links'|trans({}, 'messages') }}</span></th>
        </tr>
        </thead>
        <tbody class="govuk-table__body">
        {%- for diaryKeeper in household.diaryKeepers -%}
            {# @var diaryKeeper App\Entity\DiaryKeeper #}
            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__cell">{{ diaryKeeper.number }}</th>
                <td class="govuk-table__cell">{{ diaryKeeper.name }}{%- if diaryKeeper.proxies | length > 0 %}<br>({{ "household.proxied-by" | trans({proxyNames: diaryKeeper.proxyNames | join(', ')}) }}){% endif %}</td>
                <td class="govuk-table__cell">{{ diaryKeeper.hasJourneys | format_bool | trans({}, 'messages') }}</td>
                <td class="govuk-table__cell">{{ "diary-keeper.user-identifier.media-type.choices.#{diaryKeeper.mediaType}.label" | trans({}, 'on-boarding') }}</td>
                <td class="govuk-table__cell nowrap">{{ "boolean.#{diaryKeeper.hasIdentifierForLogin ? 'true' : 'false'}" | trans({}, 'messages') }}</td>
                <td class="govuk-table__cell nowrap">{{ "household.type.#{diaryKeeper.isAdult ? 'adult' : 'child'}" | trans }}</td>
                <td class="govuk-table__cell">{{ diaryKeeperState(diaryKeeper.diaryState) }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">
                    {% set testingActions = is_feature_enabled(constant('App\\Features::REVEAL_INVITE_LINKS'))
                        ? [
                            {
                                href: url_signer.sign(
                                    url('auth_account_setup', {userId: diaryKeeper.user.id | lower}),
                                    constant('App\\Utility\\AlphagovNotify\\Reference::ACCOUNT_CREATION_LINK_EXPIRY')
                                ),
                                text: 'Invite link',
                            }
                        ] : []
                    %}
                    {% set impersonationAction = is_granted('EDIT_DIARY', diaryKeeper)
                        ? [
                            {
                                href: path('app_home', {_switch_user: diaryKeeper.user.userIdentifier}),
                                text: "household.impersonate" | trans({}, 'interviewer'),
                                visuallyHiddenText: "household.impersonate-sr-hidden-suffix" | trans({name: diaryKeeper.name}, 'interviewer')
                            }
                        ] : []
                    %}

                    {{ summaryListActionsList(
                        testingActions
                        | merge(impersonationAction)
                        | merge([
                            {
                                href: path('interviewer_dashboard_diary_keeper', {diaryKeeper: diaryKeeper.id}),
                                text: "household.diary-keeper-summary" | trans({}, 'interviewer'),
                                visuallyHiddenText: "household.diary-keeper-summary-sr-hidden-suffix" | trans(
                                    {name: diaryKeeper.name},
                                    'interviewer'
                                )
                            }
                        ])
                    ) }}
                </td>
            </tr>
        {%- else -%}
            <tr>
                <td colspan="5" class="govuk-table__cell">{{ "household.no-diary-keepers" | trans }}</td>
            </tr>
        {%- endfor -%}
        </tbody>
    </table>

    <div class="govuk-button-group">
        {% if is_granted(constant('App\\Security\\Voter\\Interviewer\\HouseholdVoter::SUBMIT'), household) %}
            <a href="{{ path('interviewer_household_submit', {household: household.id}) }}" class="govuk-button">{{ "household.submit.submit-button" | trans }}</a>
        {% endif %}
        <a href="{{ path('interviewer_dashboard_area', {areaPeriod: areaPeriod.id}) }}" class="govuk-link">{{ "household.back" | trans }}</a>
    </div>
{% endblock %}