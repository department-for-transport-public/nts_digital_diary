{% extends 'interviewer/dashboard/base.html.twig' %}
{% trans_default_domain 'interviewer' %}
{% set household = subject %}
{% set areaPeriod = household.areaPeriod %}
{% set action = 'submit-household' %}

{% block content %}
    {%- from "@GhostGovUkFrontend/components/macros.html.twig" import summaryListRow, warningText -%}

    <dl class="govuk-summary-list">
        {{ summaryListRow({
            key: "household.diary-week-start-date" | trans,
            value: household.diaryWeekStartDate|date(date_time_format.date('default')),
        }, false) }}
    </dl>

    <p class="govuk-body">{{ 'household.submit.copy' | trans }}</p>
    {{ warningText({text: 'household.submit.warning' | trans}) }}

    {{ form(form) }}
{% endblock %}
