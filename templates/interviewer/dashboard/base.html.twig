{%- extends "interviewer/base.html.twig" -%}

{% trans_default_domain "interviewer" %}

{%- block beforeMainWrapper -%}
    {{- parent() -}}

    {# @var trainingArea \App\Entity\AreaPeriod #}
    {% set trainingArea = household.areaPeriod ?? areaPeriod ?? false %}
    {%- if trainingArea.trainingInterviewer ?? false -%}
        {% include 'includes/training-banner.html.twig' with {
            trainingRecord: trainingArea.latestTrainingRecord,
            moduleUrl: path('interviewer_training_module_index', {moduleName: trainingArea.latestTrainingRecord.moduleName})
        } %}
    {% endif %}

    {{ block('breadcrumbs', 'interviewer/breadcrumbs.html.twig') }}
{%- endblock -%}

