{% extends 'travel_diary/dashboard/base.html.twig' %}
{% trans_default_domain 'travel-diary' %}

{% set translation_prefix = "day" %}
{% set title_translation_parameters = {
    dayNumber: day.number,
    date: day.date | date(date_time_format.date('with-dow'))
} %}
{% set heading_class = "govuk-heading-xl" %}

{% set breadcrumb_translation_parameters = {
    diary_keeper_name: diaryKeeper | diary_keeper_display_name,
} %}

{% block content %}
    {%- from "@GhostGovUkFrontend/components/macros.html.twig" import summaryListRow -%}
    {%- set household = diaryKeeper.household -%}
    {%- set areaPeriod = household.areaPeriod -%}

    {%- set milometerEnabled = is_feature_enabled(constant('\\App\\Features::MILOMETER')) -%}
    {%- set proseKey = milometerEnabled ? 'day.introduction-markdown.text-milometer' : 'day.introduction-markdown.text' %}
    <div class="prose-scope">{{ proseKey | trans({
            dayNumber: day.number,
            vehicleCount: diaryKeeper.primaryDriverVehicles.count,
            vehicleUrl: path('traveldiary_dashboard') ~ '#vehicles',
        }) | markdown_to_html }}
    </div>
    {% if day.isPracticeDay %}
        {% include 'travel_diary/dashboard/includes/video-help.html.twig' %}
    {% endif %}

    <dl class="govuk-summary-list">
        {%- for journey in day.journeys -%}
            {%- set linkTranslationParameters = {
                startLocation: journey.startLocationForDisplay,
                endLocation: journey.endLocationForDisplay,
            } -%}

            {{- summaryListRow({
                key: "day.journey.time" | trans({
                    time: journey.startTime | date(date_time_format.time('user-pref'))
                }),
                value: "day.journey.description" | trans({
                    startLocation: journey.startLocationForDisplay,
                    endLocation: journey.endLocationForDisplay,
                    stageCount: journey.stages | length,
                }),
                actions: [
                    {
                        href: path('traveldiary_journey_view', {journeyId: journey.id}),
                        text: "day.view" | trans({}, 'travel-diary'),
                        visuallyHiddenText: "day.view-sr-hidden-suffix" | trans(linkTranslationParameters, 'travel-diary'),
                    },
                ]
            }) -}}
        {%- else -%}
            {{- summaryListRow({
                key: "day.no-journeys" | trans,
                value: '',
            }, false) -}}
        {%- endfor -%}
    </dl>

    <div class="govuk-button-group govuk-!-margin-bottom-8">
        <a class="govuk-button" href="{{ path('traveldiary_journey_wizard_start', {dayNumber: day.number}) }}">
            {{- "day.add-journey" | trans -}}<span class="govuk-visually-hidden">
                {{- ' ' ~ ("day.add-journey-sr-hidden-suffix" | trans({
                    dayNumber: day.number,
                    date: day.date | date(date_time_format.date('with-dow'))
                })) -}}</span>
        </a>
        <a class="govuk-link" href="{{ path('traveldiary_repeat_journey_v2_wizard_start', {dayNumber: day.number}) }}">{{ "day.repeat-a-journey" | trans }}</a>
        <a class="govuk-link" href="{{ path('traveldiary_dashboard') }}">{{ "day.back" | trans }}</a>
    </div>

    {# Notes #}
    <h2 class="govuk-heading-l">{{ "day.notes.heading" | trans }}</h2>

    <p class="govuk-body">{{ 'day.notes.guidance' | trans | nl2br }}</p>

    {%- if is_impersonator_granted('ROLE_INTERVIEWER') -%}
        <p class="govuk-body">{{ 'day.notes.guidance-interviewer' | trans | nl2br }}</p>
        <dl class="govuk-summary-list">
            {{- summaryListRow({
                key: "day.notes.diary-keepers-notes" | trans,
                value: day.diaryKeeperNotes ?? ("day.notes.no-notes" | trans),
            }) -}}
            {{- summaryListRow({
                key: "day.notes.interviewers-notes" | trans,
                value: day.interviewerNotes ?? ("day.notes.no-notes" | trans),
                actions: [
                    {
                        href: path('traveldiary_day_interviewer_notes', {dayNumber: day.number}),
                        text: "day.notes.#{day.interviewerNotes ? 'edit-notes' : 'add-notes'}" | trans({}, 'travel-diary'),
                    },
                ]
            }) -}}
        </dl>
    {%- else -%}
        <p class="govuk-inset-text">{{- (day.diaryKeeperNotes ?? ("day.notes.no-notes" | trans)) | nl2br -}}</p>
        <p class="govuk-body">
            <a class="govuk-link" href="{{ path('traveldiary_day_diary_keeper_notes', {dayNumber: day.number}) }}">
                {{- "day.notes.#{day.diaryKeeperNotes ? 'edit-notes' : 'add-notes'}" | trans -}}
            </a>
        </p>
    {%- endif -%}
{% endblock %}