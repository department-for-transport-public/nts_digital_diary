{% extends 'travel_diary/base.html.twig' %}
{% trans_default_domain 'travel-diary' %}

{% set title_translation_key = "days.page-title" %}

{% set translation_parameters = {
    diary_keeper_name: diaryKeeper.name,
} %}

{%- import "@GhostGovUkFrontend/components/macros.html.twig" as m -%}
{% block content %}
    {# @var diaryKeeper \App\Entity\DiaryKeeper #}
    {%- include 'travel_diary/dashboard/includes/diary_keeper_proxies.html.twig' -%}
    {{ _self.otherDays(translation_parameters) }}

    {{ _self.travelWeek(diaryKeeper, translation_parameters) }}
    {{ _self.mileometer(diaryKeeper) }}

    {%- if workflow_can(diaryKeeper, constant('App\\Entity\\DiaryKeeper::TRANSITION_COMPLETE')) -%}
        <div class="govuk-button-group">
            <a class="govuk-button" href="{{ path('traveldiary_mark_as_complete') }}">{{ 'mark-as-complete.form.mark-as-complete' | trans }}</a>
        </div>
    {%- endif -%}

    {%- include 'travel_diary/dashboard/includes/diary_keeper_details.html.twig' -%}
{% endblock %}

{% macro travelWeek(diaryKeeper, translation_parameters) %}
    <h2 class="govuk-heading-m">{{ "days.diary-week" | trans(translation_parameters) }}</h2>
{#    <p class="govuk-body">{{ 'days.intro' | trans }}</p>#}
    <div class="prose-scope">{{ 'days.diary-week-intro-copy' | trans | markdown_to_html }}</div>
    <dl class="govuk-summary-list">
        {% for day in diaryKeeper.diaryDays %}
            {% set addJourneyUrl = is_dk_feature_enabled(constant('App\\Utility\\DiaryKeeperFeaturesService::JOURNEY_WIZARD_REFLOW'))
                ? path('traveldiary_reflow_add_journey_wizard_start', {dayNumber: day.number})
                : path('traveldiary_journey_wizard_start', {dayNumber: day.number})
            %}
            {{ m.summaryListRow({
                key: "descriptions.day" | trans({
                    dayNumber: day.number,
                    date: day.date | date(date_time_format.date('with-dow')),
                }),
                value: "days.x-journeys" | trans({
                    journeyCount: day.journeys | length,
                }),
                actions: [
                    {
                        href: addJourneyUrl,
                        text: "days.add-journey" | trans({}, 'travel-diary'),
                        visuallyHiddenText: "days.add-journey-sr-hidden-suffix" | trans({dayNumber: day.number}, 'travel-diary'),
                    },
                    {
                        href: path('traveldiary_dashboard_day', {dayNumber: day.number}),
                        text: "days.view" | trans({}, 'travel-diary'),
                        visuallyHiddenText: "days.view-sr-hidden-suffix" | trans({dayNumber: day.number}, 'travel-diary')
                    },
                ]
            }) }}
        {% endfor %}
    </dl>
{% endmacro %}

{% macro otherBits(diaryKeeper, translation_parameters) %}
    {%- include 'travel_diary/dashboard/includes/diary_keeper_proxies.html.twig' -%}
    {{ _self.otherDays(translation_parameters) }}

    {{ _self.mileometer(diaryKeeper) }}

    {%- include 'travel_diary/dashboard/includes/diary_keeper_details.html.twig' -%}
{% endmacro %}

{% macro otherDays(translation_parameters) %}
    {% set html -%}
        <ul class="govuk-list">
            <li><a class="govuk-link" href="{{ path('traveldiary_dashboard_example_day') }}">{{ "days.other-days.example-link" | trans(translation_parameters) }}</a></li>
            <li><a class="govuk-link" href="{{ path('traveldiary_dashboard_day', {'dayNumber': 0}) }}">{{ "days.other-days.practice-link" | trans(translation_parameters) }}</a></li>
        </ul>
    {%- endset %}
    {{ m.details({
        summaryText: 'days.other-days.heading' | trans,
        html: html
    }) }}
{% endmacro %}

{% macro mileometer(diaryKeeper) %}
    {% if is_feature_enabled(constant('\\App\\Features::MILOMETER')) and not diaryKeeper.primaryDriverVehicles.empty %}
{#        <h2 class="govuk-heading-m" id="vehicles">{{ 'days.primary-driver-vehicles' | trans }}</h2>#}
        <ul class="govuk-list" id="vehicles">
            {% for vehicle in diaryKeeper.primaryDriverVehicles %}
                {# @var vehicle \App\Entity\Vehicle #}
                <li><a class="govuk-link" href="{{ path('traveldiary_vehicle_index', {vehicle: vehicle.id}) }}">{{ "days.enter-odometer-readings" | trans({vehicle: vehicle.friendlyName}) }}</a></li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}