{% extends 'base.html.twig' %}
{% trans_default_domain 'auth' %}
{% set translation_domain = 'auth' %}
{% set translation_prefix = 'setup-link-expired' %}

{% block content %}
    <div class="prose-scope">
        {%- if user.password ?? false -%}
            {{- 'setup-link-expired.password-already-set-intro' | trans | markdown_to_html -}}
            {{- 'setup-link-expired.password-already-set-instruction' | trans | markdown_to_html -}}
        {%- else -%}
            {{- 'setup-link-expired.intro' | trans({emailSent: emailSent, obfuscatedEmailAddress: emailAddress}) | markdown_to_html -}}
            {{- 'setup-link-expired.instruction' | trans | markdown_to_html -}}
        {%- endif -%}
    </div>
{% endblock %}
