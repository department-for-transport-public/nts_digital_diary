{# Common macros for job queue templates #}
{% macro loadingSpinner(params) %}
    {%- from "@GhostGovUkFrontend/components/macros.html.twig" import htmlOrText -%}
    <div class="hods-loading-spinner" role="status">
        <div class="hods-loading-spinner__spinner"></div>
        {%- if params.content is defined -%}
            <div class="hods-loading-spinner__content">{{ htmlOrText(params.content) }}</div>
        {%- endif -%}
    </div>
{% endmacro %}

{% macro jobStatusSpinner(jobStatus, initialText, runningText, completedText) %}
    {%- from 'macros/job.html.twig' import loadingSpinner -%}
    {%- set statusContents -%}
        {%- if jobStatus is null or jobStatus.state == constant('App\\Messenger\\Job\\State::NEW') -%}
            <h1 class="govuk-heading-m">{{ initialText | default('Initialising...') }}</h1>
        {%- elseif jobStatus.state == constant('App\\Messenger\\Job\\State::RUNNING') -%}
            <h1 class="govuk-heading-m">{{ runningText | default('Processing...') }}</h1>
        {%- elseif jobStatus.state == constant('App\\Messenger\\Job\\State::COMPLETED') -%}
            <h1 class="govuk-heading-m">{{ completedText | default('Downloading...') }}</h1>
        {%- endif -%}
    {%- endset -%}

    {{- loadingSpinner({
        content: {html: statusContents}
    }) -}}
{% endmacro %}

{% macro autoDownloadScript(downloadUrl, redirectUrl) %}
    <script nonce="{{ csp_nonce('script') }}">
        const iframe = document.createElement('iframe')
        iframe.style.display = 'none'
        iframe.src = '{{ downloadUrl }}'
        document.body.appendChild(iframe)

        {% if redirectUrl ?? false %}
            let redirectTimeout = setTimeout(() => {
                window.location.href = '{{ redirectUrl }}'
                clearTimeout(redirectTimeout)
            }, 1500)
            {# N.B. timeout here must be less than the page refresh #}
        {% endif %}
    </script>
{% endmacro %}

{% macro fallbackDownloadLink(downloadUrl, text) %}
    <p class="govuk-body">
        {{ text|default('If your download does not start automatically, please') }} <a href="{{ downloadUrl }}" target="_blank">click here</a>.
    </p>
{% endmacro %}
