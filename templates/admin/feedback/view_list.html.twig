{% extends 'admin/base.html.twig' %}

{% trans_default_domain 'admin' %}
{% set title_translation_prefix = 'feedback.view.list' %}
{% set title_translation_domain = 'admin' %}
{% set heading_class = 'govuk-heading-l govuk-!-margin-bottom-1' %}

{% block content %}
    {% from '@GhostGovUkFrontend/components/macros.html.twig' import summaryListActionsList, tableHead, tableCell, tableRow, tag %}
    {%- from '@GhostGovUkCore/list-page.html.twig' import listTableStart, listTableEnd -%}

    <ul class="govuk-list govuk-!-margin-bottom-6">
        <li><a class="govuk-link" href="{{ path('admin_feedback_message_lookup') }}">Message lookup</a></li>
        <li><a class="govuk-link" href="{{ path('admin_feedback_stats_index') }}">Feedback stats</a></li>
    </ul>

    {{ listTableStart(data, form, {tableClass: 'feedback-message-list'}) }}
    {% for message in data.entities %}
        {# @var message \App\Entity\Feedback\Message #}
        <tr class="govuk-table__row">
            {{ tableCell({text: message.sent | date(date_time_format.date('default')) }) }}
            {{ tableCell({text: message.emailAddressOrAnon}) }}
            {{ tableCell({text: message.category.value | title}) }}
            {{ tableCell({text: message.assignedTo ?? '-'}) }}
            {{ tableCell({
                html: tag({
                    text: "feedback.view.state.labels.#{message.state}" | trans,
                    classes: 'govuk-tag govuk-tag--' ~ ("feedback.view.state.colours.#{message.state}" | trans),
                }),
            }) }}
            {{ tableCell({
                html: summaryListActionsList([
                    {
                        href: path('admin_feedback_message_view', {message: message.id}),
                        text: 'view',
                        visuallyHiddenText: "feedback from #{message.emailAddress}"
                    }
                ]),
                format: 'numeric',
            }) }}
        </tr>
    {% else %}
        {{ tableRow([
            {
                text: "No results",
                colspan: data.fields|length + 1
            }
        ]) }}
    {% endfor %}
    {{ listTableEnd(data, form) }}
{% endblock %}
