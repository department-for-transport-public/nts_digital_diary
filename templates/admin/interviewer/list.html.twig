{% extends 'admin/base.html.twig' %}

{% trans_default_domain 'admin' %}
{% set title_translation_prefix = 'interviewer.list' %}
{% set title_translation_domain = 'admin' %}

{% block content %}
    {% from '@GhostGovUkFrontend/components/macros.html.twig' import tableHead, tableCell, tableRow, summaryListActionsList, tag %}
    {%- from '@GhostGovUkCore/list-page.html.twig' import listTableStart, listTableEnd -%}

    {{ listTableStart(data, form) }}
    {% for interviewer in data.entities %}
        {# @var interviewer \App\Entity\Interviewer #}
        <tr class="govuk-table__row">
            {{ tableCell({text: interviewer.name ?? '-'}) }}
            {{ tableCell({text: interviewer.serialId ?? '-'}) }}
            {{ tableCell({text: interviewer.user.userIdentifier ?? '-'}) }}
            {{ tableCell({
                html: summaryListActionsList([
                    {
                        href: path('admin_interviewers_view', {id: interviewer.id}),
                        text: 'view',
                        visuallyHiddenText: "interviewer #{interviewer.user.userIdentifier}"
                    }
                ]),
                format: 'numeric',
            }) }}
        </tr>
    {% else %}
        {{ tableRow([
            {
                text: 'No results',
                colspan: data.fields | length + 1
            }
        ]) }}
    {% endfor %}
    {{ listTableEnd(data, form) }}

    {% if is_granted('ADMIN_INTERVIEWER_ADD') %}
        <a class="govuk-button" href="{{ url('admin_interviewers_add') }}">{{ "interviewer.list.add-button" | trans }}</a>
    {% endif %}
{% endblock %}