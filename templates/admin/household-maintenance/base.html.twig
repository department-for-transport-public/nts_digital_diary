{%- extends 'admin/base.html.twig' -%}

{% block beforeMainWrapper -%}
    {%- set breadcrumb_action = breadcrumb_action ?? null -%}

    {%- set breadcrumb_items = [
        {
            href: path('admin_household_maintenance_list'),
            text: 'household-maintenance.breadcrumbs.choose-household' | trans({}, 'admin'),
        }
    ] -%}

    {%- if household is defined -%}
        {%- set breadcrumb_items = breadcrumb_items | merge([
            {
                href: path('admin_household_maintenance_details', {id: household.id}),
                text: 'household-maintenance.breadcrumbs.household-details' | trans({serial: household.serialNumber}, 'admin'),
            }
        ]) -%}
    {%- endif -%}


    {%- if breadcrumb_action == 'user-lookup' -%}
        {%- set breadcrumb_items = breadcrumb_items | merge([
            {
                href: path('admin_user_lookup'),
                text: 'household-maintenance.breadcrumbs.user-lookup' | trans({}, 'admin'),
            }
        ]) -%}
    {%- endif -%}

    {%- if breadcrumb_items | length > 1 -%}
        {%- from '@GhostGovUkFrontend/components/macros.html.twig' import breadcrumbs -%}
        {{- breadcrumbs({items: breadcrumb_items}) -}}
    {%- endif -%}
{%- endblock -%}