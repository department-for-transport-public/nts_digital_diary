{%- extends 'admin/household-maintenance/base.html.twig' -%}

{%- trans_default_domain 'admin' -%}
{%- set title_translation_prefix = 'household-maintenance.household-details' -%}
{%- set title_translation_domain = 'admin' -%}

{%- block content -%}
    {%- from "@GhostGovUkFrontend/components/macros.html.twig" import summaryListRow -%}
    {%- from 'interviewer/dashboard/macros.html.twig' import diaryKeeperState, householdState-%}
    {{- parent() -}}

    {# This summary list, and the following table is very similar to the table used in
       interviewer/dashboard/household.html.twig, and as such, they use the same translations.
    #}
    <dl class="govuk-summary-list">
        {%- set editHouseholdLink = is_granted('EDIT_ONBOARDED_HOUSEHOLD', household)
            ? [
                {
                    key: path('admin_household_maintenance_edit', {id: household.id}),
                    text: 'change'
                }
            ] : [] -%}
        {{ summaryListRow({
            key: "Serial",
            value: household.serialNumber,
        }) }}
        {{ summaryListRow({
            key: "household.diary-week-start-date" | trans({}, 'interviewer'),
            value: household.diaryWeekStartDate|date(date_time_format.date('default')),
            actions: editHouseholdLink
        }) }}
        {{ summaryListRow({
            key: "Onboarding complete?",
            value: household.isOnboardingComplete | format_bool | trans,
        }) }}
        {{ summaryListRow({
            key: 'State',
            value: {html: householdState(household.state)},
        }) }}
        {% if household.isSubmitted %}
            {{ summaryListRow({
                key: "household.submitted-for-processing" | trans({}, 'interviewer'),
                value: household.submittedAt | date(
                    date_time_format.date('default') ~ " " ~ date_time_format.time('24-hour')
                ) ~ "\n" ~ household.submittedBy,
            }) }}
        {% endif %}
        {{ summaryListRow({
            key: "household.journey-sharing" | trans({}, 'interviewer'),
            value: ("boolean." ~ (household.journeySharingEnabled ? 'true' : 'false')) | trans([], 'messages'),
            actions: editHouseholdLink
        }) }}
        {{ summaryListRow({
            key: 'Interviewers for area',
            value: {html: household.areaPeriod.interviewers | map(i => _self.interviewerLink(i)) | join('<br>')},
        }) }}
    </dl>

    <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--m">{{ "household.diary-keepers" | trans({}, 'interviewer') }}</caption>
        <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">{{ "household.table.number" | trans({}, 'interviewer') }}</th>
            <th scope="col" class="govuk-table__header">{{ "household.table.name" | trans({}, 'interviewer') }}</th>
            <th scope="col" class="govuk-table__header">{{ "household.table.has-login" | trans({}, 'interviewer') }}</th>
            <th scope="col" class="govuk-table__header">{{ "household.table.type" | trans({}, 'interviewer') }}</th>
            <th scope="col" class="govuk-table__header">{{ "household.table.state" | trans({}, 'interviewer') }}</th>
        </tr>
        </thead>
        <tbody class="govuk-table__body">
        {%- for diaryKeeper in household.diaryKeepers -%}
            {# @var diaryKeeper \App\Entity\DiaryKeeper #}
            <tr class="govuk-table__row" id="diarykeeper-row-{{ diaryKeeper.number }}">
                <th scope="row" class="govuk-table__cell">{{ diaryKeeper.number }}</th>
                <td class="govuk-table__cell">{{ diaryKeeper.name }}{%- if diaryKeeper.proxies | length > 0 %}<br>({{ "household.proxied-by" | trans({proxyNames: diaryKeeper.proxyNames | join(', ')}, 'interviewer') }}){% endif %}</td>
                <td class="govuk-table__cell">{{ diaryKeeper.hasIdentifierForLogin | format_bool | trans }}</td>
                <td class="govuk-table__cell">{{ "household.type.#{diaryKeeper.isAdult ? 'adult' : 'child'}" | trans({}, 'interviewer') }}</td>
                <td class="govuk-table__cell">{{ diaryKeeperState(diaryKeeper.diaryState) }}</td>
            </tr>
        {%- else -%}
            <tr>
                <td colspan="5" class="govuk-table__cell">{{ "household.no-diary-keepers" | trans({}, 'interviewer') }}</td>
            </tr>
        {%- endfor -%}
        </tbody>
    </table>

    <div>
        {%- if is_granted('HOUSEHOLD_MAINTENANCE_ADD_DIARY_KEEPER', household) -%}
            <a href="{{ path('admin_household_maintenance_add_diary_keeper_place', {id: household.id}) }}" class="govuk-button govuk-button">{{ 'household-maintenance.household-details.add-diary-keeper.label' | trans }}</a>
        {%- endif -%}
        {%- if is_granted('ADMIN_VIEW_HOUSEHOLD_METRICS') -%}
            <a href="{{ path('admin_household_maintenance_metrics', {id: household.id}) }}" class="govuk-button govuk-button--secondary">View metrics</a>
        {%- endif -%}
    </div>

    <ul class="govuk-list govuk-!-margin-bottom-8">
        <li><a href="{{ path('admin_household_maintenance_list') }}" class="govuk-link">{{ 'actions.back' | trans({}, 'messages') }}</a></li>
    </ul>
{%- endblock -%}

{%- macro interviewerLink(interviewer) -%}
    <a href="{{ path('admin_interviewers_view', {id: interviewer.id}) }}">{{ interviewer.name }}</a>
{%- endmacro -%}