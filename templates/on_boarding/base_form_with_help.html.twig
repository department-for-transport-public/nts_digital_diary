{% extends 'on_boarding/base.html.twig' %}
{% trans_default_domain 'on-boarding' %}

{% block content %}
    {% if help_as_markdown ?? false %}
        <div class="prose-scope">{{ "#{translation_prefix}.help" | trans | markdown_to_html }}</div>
    {% else %}
        <p class="govuk-body">{{ "#{translation_prefix}.help" | trans | nl2br }}</p>
    {% endif %}

    {{ form(form) }}
{% endblock %}
