{%- trans_default_domain 'on-boarding' -%}

{% macro showHouseholdDetails(options) %}
    {% set options = options ?? {} %}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import summaryListRow -%}
    <div class="govuk-summary-list" id="household-details">
        {%- set actions = (options.showActions ?? true)
            ? [
                {
                    href: path('onboarding_household_index', {
                        place: constant('App\\FormWizard\\OnBoarding\\HouseholdState::STATE_DETAILS')
                    }),
                    text: 'actions.change' | trans({}, 'messages'),
                    visuallyHiddenText: 'household.details.change-action-suffix' | trans({}, 'on-boarding'),
                }
            ] : []
        -%}
        {{- summaryListRow({
            key: 'household.details.household-serial.label' | trans,
            value: app.user.household.serialNumber,
            actions: actions,
        }) -}}
        {{- summaryListRow({
            key: 'household.details.diary-start.label' | trans,
            value: app.user.household.diaryWeekStartDate | date(date_time_format.date('default')),
            actions: actions,
        }) -}}
        {%- if options.showSharingState ?? false -%}
            {%- set sharingState = app.user.household.isJourneySharingEnabled ? 'household.details.sharing-state.enabled' : 'household.details.sharing-state.disabled' -%}
            {{- summaryListRow({
                key: 'household.details.sharing-state.label' | trans,
                value: sharingState | trans,
            }) -}}
        {%- endif -%}
    </div>
{% endmacro %}

{% macro showHouseholdVehicles() %}
    {%- from '@GhostGovUkFrontend/components/macros.html.twig' import summaryListRow, summaryListRow, tabsHead -%}
    {%- if app.user.household.vehicles.empty -%}
        <div class="govuk-summary-list">
            {{- summaryListRow({
                key: "dashboard.no-vehicles" | trans,
                value: '',
            }, false) -}}
        </div>
    {%- else -%}
        <div class="govuk-tabs" data-module="govuk-tabs" id="household-vehicles">
            {# @var vehicle \App\Entity\Vehicle #}
            {%- set tabs = {} -%}
            {% for vehicle in app.user.household.vehicles %}
                {%- set tabs = tabs | merge({(vehicle.friendlyName): "tab-vehicle-#{vehicle.capiNumber}"}) -%}
            {%- endfor -%}
            {{- tabsHead(tabs) -}}
            {% for vehicle in app.user.household.vehicles %}
                <div class="govuk-tabs__panel{% if not loop.first %} govuk-tabs__panel--hidden{% endif %}" id="tab-vehicle-{{ vehicle.capiNumber }}">
                    {%- set actions = [
                        {
                            href: path('onboarding_vehicle_edit', {id: vehicle.id}),
                            text: 'actions.change' | trans({}, 'messages'),
                            visuallyHiddenText: 'vehicle',
                        }
                    ] -%}
                    <div class="govuk-summary-list">
                        {{- summaryListRow({
                            key: 'vehicle.form.capi-number.label' | trans,
                            value: vehicle.capiNumber,
                            actions: actions
                        }) -}}
                        {{- summaryListRow({
                            key: 'vehicle.form.name.label' | trans,
                            value: vehicle.friendlyName,
                            actions: actions
                        }) -}}

                        {%- set methodTranslationKey = vehicle.method.prefixedDescriptionTranslationKey('stage.method.choices.', true) -%}
                        {{- summaryListRow({
                            key: 'vehicle.form.method.label' | trans,
                            value: methodTranslationKey | trans([], 'travel-diary'),
                            actions: actions
                        }) -}}
                        {{- summaryListRow({
                            key: 'vehicle.form.primary-driver.label' | trans,
                            value: vehicle.primaryDriver ? vehicle.primaryDriver.name : '-',
                            actions: actions
                        }) -}}
                    </div>

                    <div class="govuk-button-group">
                        <a class="govuk-button govuk-button--warning" href="{{ path('onboarding_vehicle_delete', {id: vehicle.id}) }}">{{ 'actions.delete' | trans({}, 'messages') }}<span class="govuk-visually-hidden">: {{ 'vehicle.delete.delete-action-suffix' | trans({name: vehicle.friendlyName}) }}</span></a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {%- endif -%}
{% endmacro %}