{% extends "base_common.html.twig" %}

{%- from '@GhostGovUkFrontend/components/macros.html.twig' import errorSummary, footer, header, serviceNavigation -%}

{% block head -%}
    {{- encore_entry_link_tags('app', attributes={
        nonce: csp_nonce('style')
    }) -}}
    <meta name="robots" content="noindex,nofollow">
    {% if env_google_site_verification ?? false %}<meta name="google-site-verification" content="{{ env_google_site_verification }}" />{% endif %}
{%- endblock %}

{% set interviewerNavigation = (is_granted('ROLE_INTERVIEWER')) ? [
    {href: path('interviewer_dashboard'), text: 'breadcrumbs.dashboard' | trans([], 'interviewer')},
    {href: path('interviewer_training_dashboard'), text: 'breadcrumbs.training' | trans([], 'interviewer')},
    {href: path('interviewer_change_password'), text: 'breadcrumbs.change-password' | trans([], 'interviewer')},
] : [] %}
{% set supportNavigation = (is_feedback_route or is_admin) ? [] : [{href: path('app_feedback_form', {category: constant('App\\Entity\\Feedback\\CategoryEnum::Support').value, info: encodeFeedback()}), text: 'Support'}] %}
{% set preferencesNavigation = ((app.user | is_preference_user) and not is_granted('IS_IMPERSONATOR'))  ? [{href: path('app_user_preferences_index'), text: 'Preferences'}] : [] %}

{% block headerStart %}
    <style nonce="{{ csp_nonce('style') }}">
        #envLabel {
            {% if env_label_colour ?? false %}color: {{ env_label_colour }};{% endif %}
            {% if env_label_background ?? false %}background: {{ env_label_background }};{% endif %}
        }
    </style>
    {%- if env_label_frontend -%}
        <div class="govuk-warning-header" id="envLabel">
            {{ env_label_frontend | raw }}
        </div>
    {%- endif -%}
{% endblock %}

{% block headerBar %}
    {{- header({
        classes: 'govuk-header--full-width-border'
    }) -}}
{% endblock %}

{% block navigation %}
    {%- set navigation = [] | merge(
        interviewerNavigation,
        preferencesNavigation,
        supportNavigation,
        is_granted('ROLE_USER') ? [{href: logout_path(), text: 'logout' | trans}] : {}
    ) -%}
    {{ serviceNavigation({
        homepageUrl: 'https://www.gov.uk/',
        serviceName: 'service.name' | trans,
        serviceUrl: '/',
        navigation: navigation,
    }) }}
{% endblock %}

{% block beforeContent %}
    {{ parent() }}
    {%- block beforePageHeading -%}{%- endblock -%}
    {%- block pageHeading -%}
        {% set title_translation_key = title_translation_key ?? 'page-title' %}
        {# if title_translation_key contains a dot, assume it's been defined as a complete key #}
        {%- if (title_translation_key | split('.') | first) == title_translation_key -%}
            {%- set title_translation_key =
                (title_translation_prefix ?? translation_prefix ?? 'title_translation_prefix')
                ~ "." ~ title_translation_key
            -%}
        {% endif %}
        <h1 class="{{ heading_class ?? "govuk-heading-l" }}">
            {%- if is_translatable_message(title_translation_key) -%}
                {{- title_translation_key | trans -}}
            {%- else -%}
                {{- title_translation_key | trans(
                    title_translation_parameters ?? translation_parameters ?? {},
                    title_translation_domain ?? translation_domain ?? null
                ) -}}
            {%- endif -%}
        </h1>
    {% endblock %}
{% endblock %}

{% block bodyEnd %}
    {# In its own block so error pages can drop it: rendering it reads/writes the
       session (and fires the /viewport-size XHR), which we don't want on 404s. #}
    {% block viewportMonitor %}{{ include('includes/viewport-size-monitor.html.twig') }}{% endblock %}

    {%- if isVimeoUsed() -%}
        <script type="text/javascript" src="https://player.vimeo.com/api/player.js" defer></script>
    {%- endif -%}
    {{- encore_entry_script_tags('app', attributes={
        nonce: csp_nonce('script')
    }) -}}
    {{ include('includes/smartlook-session-recording.html.twig') }}
    {%- if isRecaptchaUsed() -%}
        <script type="text/javascript" src="https://www.google.com/recaptcha/api.js" async defer></script>
    {%- endif -%}
{% endblock %}

{% block footer %}
    {{ footer({
        rebrand: true,
        meta: {items: [
            {href: path('app_frontend_accessibilitystatement'), text: 'Accessibility'},
            {href: path('app_frontend_privacystatement'), text: 'Privacy'},
        ] | merge(supportNavigation)}
    }) }}
{% endblock %}
