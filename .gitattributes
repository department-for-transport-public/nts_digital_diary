# Default: treat as text, normalize to LF in the repo, native on checkout
 * text=auto eol=lf

 # Explicit text types (defensive — clarifies intent)
 *.php   text eol=lf
 *.twig  text eol=lf
 *.js    text eol=lf
 *.ts    text eol=lf
 *.css   text eol=lf
 *.scss  text eol=lf
 *.html  text eol=lf
 *.xml   text eol=lf
 *.yaml  text eol=lf
 *.yml   text eol=lf
 *.json  text eol=lf
 *.md    text eol=lf
 *.lock  text eol=lf
 *.sh    text eol=lf
 Dockerfile text eol=lf

 # Binaries — never normalize
 *.png   binary
 *.jpg   binary
 *.jpeg  binary
 *.gif   binary
 *.ico   binary
 *.svg   binary
 *.pdf   binary
 *.zip   binary
 *.gz    binary
 *.woff  binary
 *.woff2 binary
 *.ttf   binary
 *.eot   binary
 *.otf   binary
